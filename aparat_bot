from selenium import webdriver
from selenium.webdriver.chrome.options import Options
from selenium.webdriver.common.by import By
from bs4 import BeautifulSoup
import time
import random

KEYWORDS = [
    "دنبال=دنبال",
    "فالو=فالو",
    "دنبال = دنبال",
    "فالو = فالو"
]

MAX_FOLLOWS = 20


def has_keyword(text):
    text = text.replace("‌", "").strip().lower()
    return any(
        keyword.replace("‌", "").lower() in text
        for keyword in KEYWORDS
    )


def main():
    options = Options()
    options.add_argument("--headless")
    options.add_argument("--no-sandbox")
    options.add_argument("--disable-dev-shm-usage")
    options.add_argument("--disable-gpu")

    options.binary_location = (
        "/data/data/com.termux/files/usr/bin/chromium"
    )

    driver = webdriver.Chrome(options=options)

    followed = 0
    checked = set()

    try:
        driver.get("https://www.aparat.com/")
        time.sleep(5)

        print("آپارات باز شد.")

        for keyword in KEYWORDS:

            if followed >= MAX_FOLLOWS:
                break

            search_url = (
                "https://www.aparat.com/result/"
                + keyword.replace("=", "%3D")
            )

            print("جستجو:", keyword)

            driver.get(search_url)
            time.sleep(4)

            soup = BeautifulSoup(
                driver.page_source,
                "html.parser"
            )

            links = []

            for a in soup.find_all("a", href=True):
                href = a["href"]

                if "/v/" in href:
                    continue

                if "/user/" in href or "/channel/" in href:

                    if href.startswith("/"):
                        href = (
                            "https://www.aparat.com"
                            + href
                        )

                    if href not in links:
                        links.append(href)

            print("نتایج:", len(links))

            for channel in links:

                if followed >= MAX_FOLLOWS:
                    break

                if channel in checked:
                    continue

                checked.add(channel)

                try:
                    driver.get(channel)
                    time.sleep(3)

                    soup = BeautifulSoup(
                        driver.page_source,
                        "html.parser"
                    )

                    page_text = soup.get_text(
                        " ",
                        strip=True
                    )

                    if not has_keyword(page_text):
                        continue

                    print("کانال مناسب:", channel)

                    buttons = driver.find_elements(
                        By.TAG_NAME,
                        "button"
                    )

                    follow_button = None

                    for button in buttons:

                        text = button.text.strip()

                        if text == "دنبال شده":
                            print(
                                "قبلاً دنبال شده:",
                                channel
                            )
                            break

                        if text == "دنبال کردن":
                            follow_button = button
                            break

                    if follow_button:

                        follow_button.click()

                        followed += 1

                        print(
                            f"✓ فالو شد "
                            f"({followed}/{MAX_FOLLOWS})"
                        )

                        time.sleep(
                            random.randint(8, 15)
                        )

                except Exception as e:
                    print("خطا:", e)

        print()
        print("عملیات تمام شد.")
        print(
            "تعداد فالو:",
            followed,
            "/",
            MAX_FOLLOWS
        )

    finally:
        driver.quit()


if __name__ == "__main__":
    main()
